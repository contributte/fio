{
  "name": "contributte/fio",
  "description": "Easy-to-use FIO API integration for Nette Framework",
  "keywords": [
    "fio",
    "login",
    "php",
    "api",
    "nette"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/contributte/fio",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    },
    {
      "name": "Filip Šuška"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "contributte/qa": "~0.4.0",
    "contributte/phpstan": "~0.2.0",
    "contributte/tester": "~0.3.0",
    "nette/di": "^3.2.0",
    "mockery/mockery": "^1.6.0"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Fio\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "0.4.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
